# ==============================================================================
# KimHanNom API Configuration Template (.env.example)
# Copy this file to '.env' and fill in your actual credentials.
# Note: '.env' is ignored by Git to protect sensitive credentials.
# ==============================================================================

# API Base URL (Default: https://kimhannom.fit.hcmus.edu.vn)
KIMHANNOM_BASE_URL=https://kimhannom.fit.hcmus.edu.vn

# API User Account Email
KIMHANNOM_EMAIL=your_email_here@example.com

# API User Account Password
KIMHANNOM_PASSWORD=your_password_here
